@startuml
title Diagramme de séquence - Modifier un utilisateur

skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F1F5F9
  ActorBorderColor #334155
  ActorBackgroundColor #E0F2FE
  DatabaseBorderColor #334155
  DatabaseBackgroundColor #ECFDF5
}

autonumber

actor "Administrateur" as Admin
boundary "Interface React\nUserManagement.tsx" as Interface
control "api.ts" as ApiService
control "UserController" as UserController
entity "Modèle User" as UserModel
database "Base de données\nPostgreSQL" as DB
control "NotificationService" as NotificationService
actor "Utilisateur modifié" as Utilisateur

== Accès à la gestion des utilisateurs ==

Admin -> Interface : ouvrir la page Gestion des utilisateurs
Interface -> ApiService : GET /api/admin/users
ApiService -> UserController : récupérer la liste des utilisateurs
UserController -> DB : SELECT * FROM users
DB --> UserController : liste des utilisateurs
UserController --> ApiService : réponse JSON
ApiService --> Interface : utilisateurs
Interface --> Admin : afficher la liste des utilisateurs

== Modification d'un utilisateur ==

Admin -> Interface : sélectionner un utilisateur
Admin -> Interface : modifier les informations\n(nom, prénom, email, rôle, statut)
Admin -> Interface : cliquer sur Enregistrer
Interface -> Interface : contrôler les champs du formulaire

alt Champs invalides
    Interface --> Admin : afficher les erreurs de saisie
else Champs valides
    Interface -> ApiService : PUT /api/admin/users/{id}\n(données modifiées)
    ApiService -> UserController : updateUser(id, données)
    UserController -> UserController : vérifier que l'utilisateur connecté est admin

    alt Administrateur non autorisé
        UserController --> ApiService : réponse 403\nAccès refusé
        ApiService --> Interface : erreur d'autorisation
        Interface --> Admin : afficher Accès refusé
    else Administrateur autorisé
        UserController -> UserModel : rechercher utilisateur par id
        UserModel -> DB : SELECT * FROM users WHERE id = ?
        DB --> UserModel : utilisateur trouvé ou null
        UserModel --> UserController : résultat de la recherche

        alt Utilisateur introuvable
            UserController --> ApiService : réponse 404\nUtilisateur introuvable
            ApiService --> Interface : erreur
            Interface --> Admin : afficher Utilisateur introuvable
        else Utilisateur trouvé
            UserController -> UserController : valider les données reçues

            alt Email déjà utilisé par un autre compte
                UserController --> ApiService : réponse 422\nEmail déjà utilisé
                ApiService --> Interface : erreurs de validation
                Interface --> Admin : afficher message d'erreur
            else Données valides
                UserController -> UserModel : mettre à jour l'utilisateur
                UserModel -> DB : UPDATE users SET ... WHERE id = ?
                DB --> UserModel : utilisateur mis à jour
                UserModel --> UserController : utilisateur modifié

                opt Notification de modification
                    UserController -> NotificationService : notifier l'utilisateur modifié
                    NotificationService -> DB : INSERT INTO notifications
                    DB --> NotificationService : notification enregistrée
                    NotificationService --> Utilisateur : notification de mise à jour du compte
                end

                UserController --> ApiService : réponse 200\nUtilisateur modifié avec succès
                ApiService --> Interface : utilisateur mis à jour
                Interface -> Interface : mettre à jour la liste affichée
                Interface --> Admin : afficher message de succès
            end
        end
    end
end

@enduml
