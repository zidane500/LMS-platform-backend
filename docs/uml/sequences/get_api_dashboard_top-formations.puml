@startuml
title Séquence - GET /api/dashboard/top-formations

actor Utilisateur
participant "Frontend React" as Frontend
participant "DashboardController" as Controller
database "PostgreSQL" as DB

Utilisateur -> Frontend : Action utilisateur
Frontend -> Controller : GET /api/dashboard/top-formations
Controller -> Controller : topFormations()
Controller -> DB : Lecture des données
DB --> Controller : Résultat
Controller --> Frontend : Réponse JSON
Frontend --> Utilisateur : Affichage du résultat

@enduml
