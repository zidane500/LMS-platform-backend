@startuml
title Séquence - GET /api/formations/{id}/verifier-acces

actor Utilisateur
participant "Frontend React" as Frontend
participant "FormationController" as Controller
database "PostgreSQL" as DB

Utilisateur -> Frontend : Action utilisateur
Frontend -> Controller : GET /api/formations/{id}/verifier-acces
Controller -> Controller : verifierAcces()
Controller -> DB : Lecture des données
DB --> Controller : Résultat
Controller --> Frontend : Réponse JSON
Frontend --> Utilisateur : Affichage du résultat

@enduml
