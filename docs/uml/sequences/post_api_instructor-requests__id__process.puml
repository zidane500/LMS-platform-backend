@startuml
title Séquence - POST /api/instructor-requests/{id}/process

actor Utilisateur
participant "Frontend React" as Frontend
participant "InstructorRequestController" as Controller
database "PostgreSQL" as DB

Utilisateur -> Frontend : Action utilisateur
Frontend -> Controller : POST /api/instructor-requests/{id}/process
Controller -> Controller : process()
Controller -> DB : Écriture / modification des données
DB --> Controller : Résultat
Controller --> Frontend : Réponse JSON
Frontend --> Utilisateur : Affichage du résultat

@enduml
