@startuml
title Séquence - GET /api/formations/{id}/messages

actor Utilisateur
participant "Frontend React" as Frontend
participant "MessageController" as Controller
database "PostgreSQL" as DB

Utilisateur -> Frontend : Action utilisateur
Frontend -> Controller : GET /api/formations/{id}/messages
Controller -> Controller : index()
Controller -> DB : Lecture des données
DB --> Controller : Résultat
Controller --> Frontend : Réponse JSON
Frontend --> Utilisateur : Affichage du résultat

@enduml
