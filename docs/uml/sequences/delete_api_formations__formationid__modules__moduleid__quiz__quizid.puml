@startuml
title Séquence - DELETE /api/formations/{formationId}/modules/{moduleId}/quiz/{quizId}

actor Utilisateur
participant "Frontend React" as Frontend
participant "QuizController" as Controller
database "PostgreSQL" as DB

Utilisateur -> Frontend : Action utilisateur
Frontend -> Controller : DELETE /api/formations/{formationId}/modules/{moduleId}/quiz/{quizId}
Controller -> Controller : destroy()
Controller -> DB : Écriture / modification des données
DB --> Controller : Résultat
Controller --> Frontend : Réponse JSON
Frontend --> Utilisateur : Affichage du résultat

@enduml
