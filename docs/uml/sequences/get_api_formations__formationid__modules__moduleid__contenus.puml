@startuml
title Séquence - GET /api/formations/{formationId}/modules/{moduleId}/contenus

actor Utilisateur
participant "Frontend React" as Frontend
participant "ContenuController" as Controller
database "PostgreSQL" as DB

Utilisateur -> Frontend : Action utilisateur
Frontend -> Controller : GET /api/formations/{formationId}/modules/{moduleId}/contenus
Controller -> Controller : index()
Controller -> DB : Lecture des données
DB --> Controller : Résultat
Controller --> Frontend : Réponse JSON
Frontend --> Utilisateur : Affichage du résultat

@enduml
