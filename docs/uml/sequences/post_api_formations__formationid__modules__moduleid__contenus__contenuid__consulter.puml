@startuml
title Séquence - POST /api/formations/{formationId}/modules/{moduleId}/contenus/{contenuId}/consulter

actor Utilisateur
participant "Frontend React" as Frontend
participant "ContenuController" as Controller
database "PostgreSQL" as DB

Utilisateur -> Frontend : Action utilisateur
Frontend -> Controller : POST /api/formations/{formationId}/modules/{moduleId}/contenus/{contenuId}/consulter
Controller -> Controller : marquerConsulte()
Controller -> DB : Écriture / modification des données
DB --> Controller : Résultat
Controller --> Frontend : Réponse JSON
Frontend --> Utilisateur : Affichage du résultat

@enduml
