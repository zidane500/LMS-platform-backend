@startuml
title Diagramme de séquence - Envoyer un message

skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 16
skinparam titleFontSize 22

skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC

  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F1F5F9
  ParticipantFontSize 17

  ActorBorderColor #334155
  ActorBackgroundColor #E0F2FE
  ActorFontSize 17

  DatabaseBorderColor #334155
  DatabaseBackgroundColor #ECFDF5
  DatabaseFontSize 17

  ArrowFontSize 16
  NoteFontSize 16
}

autonumber

actor "Utilisateur émetteur\n(Apprenant / Formateur)" as Emetteur
boundary "Interface React\nMessagerie" as Interface
control "MessageController" as MessageController
database "Base de données" as DB
control "Service temps réel" as Realtime
actor "Utilisateur destinataire\n(Formateur / Apprenant)" as Destinataire

== Envoi du message ==

Emetteur -> Interface : ouvrir la discussion
Interface --> Emetteur : afficher la conversation

Emetteur -> Interface : saisir un message
Emetteur -> Interface : cliquer sur Envoyer

Interface -> Interface : vérifier le message

alt Message vide ou invalide
    Interface --> Emetteur : afficher une erreur
else Message valide
    Interface -> MessageController : envoyer le message

    MessageController -> MessageController : vérifier l'accès à la discussion
    MessageController -> DB : enregistrer le message
    DB --> MessageController : message enregistré

    MessageController -> Realtime : diffuser le nouveau message
    Realtime --> Destinataire : afficher le message reçu

    MessageController --> Interface : confirmer l'envoi
    Interface --> Emetteur : afficher le message envoyé
end

@enduml