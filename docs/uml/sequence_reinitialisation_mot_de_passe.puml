@startuml
title Diagramme de séquence - Réinitialisation d'un mot de passe oublié

skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F1F5F9
  ActorBorderColor #334155
  ActorBackgroundColor #E0F2FE
  DatabaseBorderColor #334155
  DatabaseBackgroundColor #ECFDF5
}

autonumber

actor "Utilisateur" as Utilisateur
boundary "Interface React\nForgotPassword.tsx" as ForgotUI
boundary "Interface React\nResetPassword.tsx" as ResetUI
control "authService.ts" as AuthService
control "AuthController" as AuthController
entity "Modèle User" as UserModel
database "Base de données\nPostgreSQL" as DB
control "Service Mail" as MailService
actor "Boîte e-mail" as EmailBox

== Demande de réinitialisation ==

loop Tant que la demande n'est pas valide
    Utilisateur -> ForgotUI : saisir son adresse e-mail
    Utilisateur -> ForgotUI : cliquer sur Mot de passe oublié
    ForgotUI -> ForgotUI : contrôler le champ e-mail

    alt E-mail vide ou format invalide
        ForgotUI --> Utilisateur : afficher les erreurs de saisie
    else E-mail valide
        ForgotUI -> AuthService : forgotPassword(email)
        AuthService -> AuthController : POST /api/forgot-password\n(email)
        AuthController -> AuthController : valider la requête
        AuthController -> UserModel : rechercher utilisateur par e-mail
        UserModel -> DB : SELECT * FROM users WHERE email = ?
        DB --> UserModel : utilisateur trouvé ou null
        UserModel --> AuthController : résultat de la recherche

        alt Utilisateur introuvable
            AuthController --> AuthService : réponse 404 ou 422\nE-mail introuvable
            AuthService --> ForgotUI : erreur
            ForgotUI --> Utilisateur : afficher message d'erreur
        else Utilisateur trouvé
            AuthController -> AuthController : générer token de réinitialisation
            AuthController -> DB : INSERT/UPDATE password_reset_tokens
            DB --> AuthController : token enregistré
            AuthController -> MailService : envoyer lien de réinitialisation
            MailService -> EmailBox : envoyer e-mail avec lien sécurisé
            EmailBox --> Utilisateur : recevoir le lien de réinitialisation
            AuthController --> AuthService : réponse 200\nLien envoyé
            AuthService --> ForgotUI : confirmation
            ForgotUI --> Utilisateur : afficher message de succès
        end
    end
end

== Réinitialisation du mot de passe ==

Utilisateur -> EmailBox : ouvrir l'e-mail reçu
Utilisateur -> ResetUI : cliquer sur le lien de réinitialisation
ResetUI -> ResetUI : afficher formulaire nouveau mot de passe
Utilisateur -> ResetUI : saisir nouveau mot de passe et confirmation
Utilisateur -> ResetUI : cliquer sur Réinitialiser
ResetUI -> ResetUI : contrôler les champs

alt Champs invalides ou mots de passe différents
    ResetUI --> Utilisateur : afficher les erreurs de validation
else Champs valides
    ResetUI -> AuthService : resetPassword(email, token, password)
    AuthService -> AuthController : POST /api/reset-password\n(email, token, password)
    AuthController -> AuthController : valider les données reçues
    AuthController -> DB : vérifier token dans password_reset_tokens
    DB --> AuthController : token valide ou invalide

    alt Token invalide ou expiré
        AuthController --> AuthService : réponse 400/422\nToken invalide ou expiré
        AuthService --> ResetUI : erreur
        ResetUI --> Utilisateur : afficher message d'erreur
    else Token valide
        AuthController -> AuthController : hacher le nouveau mot de passe
        AuthController -> UserModel : mettre à jour le mot de passe
        UserModel -> DB : UPDATE users SET password = ? WHERE email = ?
        DB --> UserModel : mot de passe modifié
        UserModel --> AuthController : utilisateur mis à jour
        AuthController -> DB : supprimer le token utilisé
        DB --> AuthController : token supprimé
        AuthController --> AuthService : réponse 200\nMot de passe réinitialisé
        AuthService --> ResetUI : confirmation
        ResetUI --> Utilisateur : afficher succès et rediriger vers Login
    end
end

@enduml
