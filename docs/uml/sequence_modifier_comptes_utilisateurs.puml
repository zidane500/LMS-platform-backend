@startuml
title Diagramme de séquence - Modification des comptes utilisateurs

skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F1F5F9
  ActorBorderColor #334155
  ActorBackgroundColor #E0F2FE
  DatabaseBorderColor #334155
  DatabaseBackgroundColor #ECFDF5
}

autonumber

actor "Super Admin" as Admin
boundary "Interface React\nGestion des utilisateurs" as Interface
control "UserController" as UserController
database "Base de données" as DB
control "NotificationService" as NotificationService
actor "Utilisateur concerné" as Utilisateur

== Consultation des comptes utilisateurs ==

Admin -> Interface : ouvrir la page de gestion des utilisateurs
Interface -> UserController : demander la liste des utilisateurs
UserController -> DB : récupérer les comptes utilisateurs
DB --> UserController : liste des utilisateurs
UserController --> Interface : retourner la liste
Interface --> Admin : afficher les comptes utilisateurs

== Modification d'un compte ==

Admin -> Interface : sélectionner un utilisateur
Interface --> Admin : afficher les informations du compte

Admin -> Interface : modifier les informations
note right of Interface
Nom
Prénom
Email
Téléphone
Rôle
Statut du compte
end note

Admin -> Interface : cliquer sur Enregistrer
Interface -> Interface : vérifier les champs du formulaire

alt Champs invalides
    Interface --> Admin : afficher les erreurs de saisie
else Champs valides
    Interface -> UserController : envoyer les nouvelles informations

    UserController -> DB : rechercher le compte utilisateur
    DB --> UserController : utilisateur trouvé ou introuvable

    alt Utilisateur introuvable
        UserController --> Interface : retourner une erreur
        Interface --> Admin : afficher utilisateur introuvable
    else Utilisateur trouvé
        UserController -> UserController : valider les informations reçues

        alt Informations invalides
            UserController --> Interface : retourner les erreurs de validation
            Interface --> Admin : afficher les erreurs
        else Informations valides
            UserController -> DB : mettre à jour le compte utilisateur
            DB --> UserController : compte modifié

            UserController -> NotificationService : notifier l'utilisateur concerné
            NotificationService -> DB : enregistrer la notification
            DB --> NotificationService : notification enregistrée

            NotificationService --> Utilisateur : recevoir la notification

            UserController --> Interface : confirmer la modification
            Interface --> Admin : afficher message de succès
        end
    end
end

@enduml