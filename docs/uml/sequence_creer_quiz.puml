@startuml
title Diagramme de séquence - Créer un quiz

skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 15
skinparam titleFontSize 20

skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC

  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F1F5F9
  ParticipantFontSize 16

  ActorBorderColor #334155
  ActorBackgroundColor #E0F2FE
  ActorFontSize 16

  DatabaseBorderColor #334155
  DatabaseBackgroundColor #ECFDF5
  DatabaseFontSize 16

  ArrowFontSize 15
  NoteFontSize 15
}

autonumber

actor "Administrateur / Formateur" as Acteur
boundary "Interface React\nEditQuiz.tsx" as Interface
control "QuizController" as QuizController
entity "Modèle ModuleFormation" as Module
entity "Modèle Quiz" as Quiz
entity "Modèle Question" as Question
entity "Modèle ChoixReponse" as ChoixReponse
database "Base de données\nPostgreSQL" as DB

== Accès à la création du quiz ==

Acteur -> Interface : ouvrir la page de création du quiz
Interface -> QuizController : demander les informations du module
QuizController -> DB : rechercher la formation et le module
DB --> QuizController : résultat de la recherche

alt Formation ou module introuvable
    QuizController --> Interface : retourner une erreur
    Interface --> Acteur : afficher formation ou module introuvable
else Formation et module trouvés
    QuizController --> Interface : retourner les informations nécessaires
    Interface --> Acteur : afficher le formulaire du quiz
end

== Saisie du quiz ==

Acteur -> Interface : remplir les informations du quiz

note right of Interface
Titre
Description
Seuil de réussite
Durée en minutes
Nombre de tentatives
Statut
Questions
Choix de réponses
Barème
end note

Acteur -> Interface : cliquer sur Enregistrer
Interface -> Interface : vérifier les champs obligatoires

alt Champs invalides
    Interface --> Acteur : afficher les erreurs de saisie
else Champs valides
    Interface -> QuizController : envoyer les données du quiz\nPOST /formations/{formationId}/modules/{moduleId}/quiz

    == Traitement côté serveur ==

    QuizController -> Module : vérifier le module concerné
    Module -> DB : rechercher le module
    DB --> Module : module trouvé ou introuvable
    Module --> QuizController : résultat

    alt Module introuvable
        QuizController --> Interface : retourner une erreur
        Interface --> Acteur : afficher module introuvable
    else Module trouvé
        QuizController -> QuizController : vérifier le droit de création

        alt Accès refusé
            QuizController --> Interface : refuser l'opération
            Interface --> Acteur : afficher accès refusé
        else Accès autorisé
            QuizController -> QuizController : valider les données du quiz

            alt Données invalides
                QuizController --> Interface : retourner les erreurs de validation
                Interface --> Acteur : afficher les erreurs
            else Données valides
                QuizController -> Quiz : créer le quiz
                Quiz -> DB : enregistrer le quiz
                DB --> Quiz : quiz enregistré
                Quiz --> QuizController : quiz créé

                loop Pour chaque question ajoutée
                    QuizController -> Question : créer la question
                    Question -> DB : enregistrer la question
                    DB --> Question : question enregistrée

                    alt Question QCM ou Vrai/Faux
                        loop Pour chaque choix de réponse
                            QuizController -> ChoixReponse : créer le choix
                            ChoixReponse -> DB : enregistrer le choix
                            DB --> ChoixReponse : choix enregistré
                        end
                    else Question à réponse libre
                        QuizController -> DB : enregistrer la réponse attendue et le barème
                        DB --> QuizController : correction attendue enregistrée
                    end
                end

                QuizController --> Interface : retourner le quiz créé
                Interface --> Acteur : afficher message de succès
                Interface --> Acteur : rediriger vers la formation ou le quiz
            end
        end
    end
end

@enduml