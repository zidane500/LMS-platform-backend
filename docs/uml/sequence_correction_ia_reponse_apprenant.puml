@startuml
title Diagramme de séquence - Correction IA de la réponse de l'apprenant

skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 15
skinparam titleFontSize 20

skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC

  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F1F5F9
  ParticipantFontSize 16

  ActorBorderColor #334155
  ActorBackgroundColor #E0F2FE
  ActorFontSize 16

  DatabaseBorderColor #334155
  DatabaseBackgroundColor #ECFDF5
  DatabaseFontSize 16

  ArrowFontSize 15
  NoteFontSize 15
}

autonumber

actor "Apprenant" as Apprenant
boundary "Interface React\nQuiz.tsx" as Interface
control "QuizController" as QuizController
entity "Modèle Quiz" as Quiz
entity "Modèle Question" as Question
entity "Modèle TentativeQuiz" as Tentative
entity "Modèle ReponseApprenant" as Reponse
control "GlmCorrectionService" as IAService
database "Base de données\nPostgreSQL" as DB
actor "Modèle IA" as ModeleIA

== Passage du quiz ==

Apprenant -> Interface : répondre aux questions du quiz
Apprenant -> Interface : cliquer sur Soumettre

Interface -> Interface : vérifier les réponses saisies

alt Réponses invalides
    Interface --> Apprenant : afficher les erreurs de saisie
else Réponses valides
    Interface -> QuizController : envoyer les réponses\nPOST /formations/{formationId}/modules/{moduleId}/quiz/{quizId}/passer

    QuizController -> Quiz : vérifier le quiz concerné
    Quiz -> DB : rechercher le quiz
    DB --> Quiz : quiz trouvé ou introuvable
    Quiz --> QuizController : résultat

    alt Quiz introuvable
        QuizController --> Interface : retourner une erreur
        Interface --> Apprenant : afficher quiz introuvable
    else Quiz trouvé
        QuizController -> QuizController : vérifier les tentatives disponibles
        QuizController -> Tentative : créer une tentative de quiz
        Tentative -> DB : enregistrer la tentative
        DB --> Tentative : tentative enregistrée
        Tentative --> QuizController : tentative créée

        == Correction des réponses ==

        loop Pour chaque réponse de l'apprenant
            QuizController -> Question : récupérer la question
            Question -> DB : rechercher la question et son type
            DB --> Question : question récupérée
            Question --> QuizController : type de question

            alt Question QCM ou Vrai/Faux
                QuizController -> QuizController : corriger automatiquement la réponse
                QuizController -> Reponse : enregistrer la réponse corrigée
                Reponse -> DB : enregistrer est_correct et points_obtenus
                DB --> Reponse : réponse enregistrée
                Reponse --> QuizController : réponse corrigée
            else Question à réponse libre
                QuizController -> IAService : envoyer la réponse libre à corriger

                note right of IAService
                Données envoyées :
                - texte de la question
                - réponse de l'apprenant
                - correction attendue
                - contexte du quiz
                - points maximum
                end note

                IAService -> ModeleIA : demander correction automatique
                ModeleIA --> IAService : retourner score et feedback

                IAService --> QuizController : résultat de correction IA

                note right of QuizController
                Résultat reçu :
                - score IA
                - feedback personnalisé
                - points forts
                - points à améliorer
                - points obtenus
                end note

                QuizController -> Reponse : enregistrer la correction IA
                Reponse -> DB : enregistrer réponse, score IA et feedback
                DB --> Reponse : correction enregistrée
                Reponse --> QuizController : réponse corrigée par IA
            end
        end

        == Calcul du résultat final ==

        QuizController -> Tentative : calculer le score final
        Tentative -> DB : mettre à jour score, réussite et durée
        DB --> Tentative : tentative mise à jour
        Tentative --> QuizController : résultat final

        QuizController --> Interface : retourner score, réussite et feedback
        Interface --> Apprenant : afficher résultat du quiz
        Interface --> Apprenant : afficher feedback personnalisé
    end
end

@enduml