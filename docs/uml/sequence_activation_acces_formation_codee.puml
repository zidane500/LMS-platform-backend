@startuml
title Diagramme de séquence - Activation de l'accès à la création d'une formation codée

skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F1F5F9
  ActorBorderColor #334155
  ActorBackgroundColor #E0F2FE
  DatabaseBorderColor #334155
  DatabaseBackgroundColor #ECFDF5
}

autonumber

actor "Super Admin" as Admin
boundary "Interface React\nGestion des utilisateurs" as Interface
control "UserController" as UserController
database "Base de données" as DB
control "NotificationService" as NotificationService
actor "Formateur concerné" as Formateur

== Consultation du compte formateur ==

Admin -> Interface : ouvrir la gestion des utilisateurs
Interface -> UserController : demander la liste des utilisateurs
UserController -> DB : récupérer les comptes utilisateurs
DB --> UserController : retourner les utilisateurs
UserController --> Interface : envoyer la liste
Interface --> Admin : afficher les comptes utilisateurs

== Activation de l'accès formation codée ==

Admin -> Interface : sélectionner un compte formateur
Admin -> Interface : activer l'option "Peut créer une formation codée"

Interface -> UserController : envoyer la demande d'activation\nPOST /admin/users/{id}/toggle-peut-coder

UserController -> DB : rechercher le compte formateur
DB --> UserController : compte trouvé ou introuvable

alt Compte introuvable
    UserController --> Interface : retourner une erreur
    Interface --> Admin : afficher compte introuvable
else Compte trouvé
    UserController -> UserController : vérifier que le compte est formateur

    alt Compte non formateur
        UserController --> Interface : refuser l'activation
        Interface --> Admin : afficher message d'erreur
    else Compte formateur
        UserController -> DB : activer l'autorisation peut_coder
        DB --> UserController : autorisation mise à jour

        UserController -> NotificationService : notifier le formateur
        NotificationService -> DB : enregistrer la notification
        DB --> NotificationService : notification enregistrée

        NotificationService --> Formateur : recevoir notification d'autorisation

        UserController --> Interface : confirmer l'activation
        Interface --> Admin : afficher message de succès
    end
end

@enduml