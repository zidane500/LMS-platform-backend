@startuml
title Diagramme de séquence - Création d'une formation

skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F1F5F9
  ActorBorderColor #334155
  ActorBackgroundColor #E0F2FE
  DatabaseBorderColor #334155
  DatabaseBackgroundColor #ECFDF5
}

autonumber

actor "Administrateur / Formateur" as Acteur
boundary "Interface React" as Interface
control "FormationController" as Controller
database "Base de données" as DB

Acteur -> Interface : remplir le formulaire de formation
Acteur -> Interface : cliquer sur Enregistrer

Interface -> Controller : envoyer les données de la formation
Controller -> Controller : vérifier les données et les droits

alt Données incorrectes
    Controller --> Interface : retourner les erreurs
    Interface --> Acteur : afficher les erreurs
else Données correctes
    Controller -> DB : enregistrer la formation
    DB --> Controller : confirmation
    Controller --> Interface : formation créée
    Interface --> Acteur : afficher message de succès
end

@enduml