@startuml
title Diagramme de séquence - Vérification d'un certificat par scan du code QR

skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F1F5F9
  ActorBorderColor #334155
  ActorBackgroundColor #E0F2FE
  DatabaseBorderColor #334155
  DatabaseBackgroundColor #ECFDF5
}

autonumber

actor "Utilisateur externe\nou recruteur" as Visiteur
boundary "Scanner QR Code" as Scanner
boundary "Page publique\nVerifyCertificate.tsx" as Interface
control "CertificatController" as CertificatController
entity "Certificat" as Certificat
database "Base de données" as DB

== Scan du certificat ==

Visiteur -> Scanner : scanner le QR code du certificat
Scanner -> Interface : ouvrir le lien de vérification\n/verify/{numero}

== Demande de vérification ==

Interface -> CertificatController : demander la vérification du certificat
CertificatController -> DB : rechercher le certificat par numéro
DB --> CertificatController : résultat de la recherche

alt Certificat introuvable
    CertificatController --> Interface : certificat non valide
    Interface --> Visiteur : afficher message d'erreur
else Certificat trouvé
    CertificatController -> Certificat : charger les informations du certificat
    Certificat -> DB : récupérer apprenant, formation et score
    DB --> Certificat : informations du certificat
    Certificat --> CertificatController : certificat complet

    CertificatController --> Interface : retourner les informations vérifiées
    Interface --> Visiteur : afficher certificat valide
end

@enduml