@startuml
title Diagramme de séquence - Consulter les notifications

skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 16
skinparam titleFontSize 22

skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC

  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F1F5F9
  ParticipantFontSize 17

  ActorBorderColor #334155
  ActorBackgroundColor #E0F2FE
  ActorFontSize 17

  DatabaseBorderColor #334155
  DatabaseBackgroundColor #ECFDF5
  DatabaseFontSize 17

  ArrowFontSize 16
  NoteFontSize 16
}

autonumber

actor "Utilisateur\n(Apprenant / Formateur / Admin)" as Utilisateur
boundary "Interface React\nNotificationBell" as Interface
control "NotificationController" as NotificationController
entity "Modèle Notification" as Notification
database "Base de données\nPostgreSQL" as DB

== Chargement du compteur ==

Interface -> NotificationController : demander le nombre de notifications non lues
NotificationController -> DB : compter les notifications non lues
DB --> NotificationController : nombre de notifications
NotificationController --> Interface : retourner le compteur
Interface --> Utilisateur : afficher le badge de notification

== Consultation des notifications ==

Utilisateur -> Interface : cliquer sur la cloche de notification
Interface -> NotificationController : demander la liste des notifications
NotificationController -> Notification : récupérer les notifications de l'utilisateur
Notification -> DB : rechercher les notifications récentes
DB --> Notification : notifications trouvées
Notification --> NotificationController : liste des notifications
NotificationController --> Interface : retourner les notifications
Interface --> Utilisateur : afficher la liste des notifications

alt Aucune notification disponible
    Interface --> Utilisateur : afficher "Aucune notification"
else Notifications disponibles
    Interface --> Utilisateur : afficher type, message, date et état de lecture
end

== Actions possibles ==

opt Filtrer les notifications
    Utilisateur -> Interface : choisir un type de notification
    Interface -> Interface : filtrer par type
    Interface --> Utilisateur : afficher les notifications filtrées
end

opt Marquer une notification comme lue
    Utilisateur -> Interface : sélectionner une notification non lue
    Interface -> NotificationController : marquer la notification comme lue
    NotificationController -> DB : mettre à jour l'état lu
    DB --> NotificationController : notification mise à jour
    NotificationController --> Interface : confirmer la lecture
    Interface --> Utilisateur : mettre à jour l'affichage
end

opt Marquer toutes les notifications comme lues
    Utilisateur -> Interface : cliquer sur Tout lire
    Interface -> NotificationController : marquer toutes les notifications comme lues
    NotificationController -> DB : mettre à jour toutes les notifications
    DB --> NotificationController : notifications mises à jour
    NotificationController --> Interface : confirmer l'opération
    Interface --> Utilisateur : réinitialiser le compteur
end

opt Supprimer une notification
    Utilisateur -> Interface : cliquer sur Supprimer
    Interface -> NotificationController : supprimer la notification
    NotificationController -> DB : supprimer la notification
    DB --> NotificationController : notification supprimée
    NotificationController --> Interface : confirmer la suppression
    Interface --> Utilisateur : retirer la notification de la liste
end

@enduml