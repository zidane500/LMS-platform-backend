@startuml
title Diagramme de séquence - Envoyer un rappel d'inactivité

skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 16
skinparam titleFontSize 22

skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC

  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F1F5F9
  ParticipantFontSize 17

  ActorBorderColor #334155
  ActorBackgroundColor #E0F2FE
  ActorFontSize 17

  DatabaseBorderColor #334155
  DatabaseBackgroundColor #ECFDF5
  DatabaseFontSize 17

  ArrowFontSize 16
  NoteFontSize 16
}

autonumber

actor "Planificateur Laravel" as Scheduler
control "Commande\nSendRappelNotifications" as Commande
entity "Modèle Inscription" as Inscription
entity "Modèle ProgressionFormation" as ProgressionFormation
entity "Modèle ProgressionContenu" as ProgressionContenu
control "NotificationService" as NotificationService
entity "Modèle Notification" as Notification
database "Base de données\nPostgreSQL" as DB
actor "Utilisateur concerné\n(Apprenant / Formateur)" as Utilisateur

== Déclenchement automatique ==

Scheduler -> Commande : exécuter la commande\nnotifications:rappel

Commande -> Inscription : récupérer les inscriptions
Inscription -> DB : charger les utilisateurs et formations inscrits
DB --> Inscription : liste des inscriptions
Inscription --> Commande : inscriptions récupérées

== Analyse des inscriptions ==

loop Pour chaque inscription
    Commande -> Commande : vérifier utilisateur et formation

    alt Données manquantes
        Commande -> Commande : passer à l'inscription suivante
    else Données valides
        Commande -> Commande : vérifier le rôle utilisateur

        alt Rôle non concerné
            Commande -> Commande : ignorer l'utilisateur
        else Apprenant ou formateur
            Commande -> ProgressionFormation : vérifier si la formation est terminée
            ProgressionFormation -> DB : rechercher la progression de la formation
            DB --> ProgressionFormation : progression trouvée ou non
            ProgressionFormation --> Commande : état de progression

            alt Formation déjà terminée
                Commande -> Commande : ne pas envoyer de rappel
            else Formation non terminée
                Commande -> ProgressionContenu : rechercher la dernière consultation
                ProgressionContenu -> DB : récupérer la dernière activité sur la formation
                DB --> ProgressionContenu : date de dernière consultation
                ProgressionContenu --> Commande : dernière consultation trouvée

                alt Aucune consultation
                    Commande -> Commande : ne pas envoyer de rappel
                else Consultation existante
                    Commande -> Commande : vérifier inactivité supérieure à 24h

                    alt Inactivité inférieure à 24h
                        Commande -> Commande : ne pas envoyer de rappel
                    else Inactivité supérieure à 24h
                        Commande -> Notification : vérifier rappel récent
                        Notification -> DB : rechercher rappel envoyé dans les dernières 24h
                        DB --> Notification : rappel existant ou non
                        Notification --> Commande : résultat

                        alt Rappel déjà envoyé récemment
                            Commande -> Commande : éviter le doublon
                        else Aucun rappel récent
                            Commande -> NotificationService : créer notification de type rappel
                            NotificationService -> Notification : préparer la notification
                            Notification -> DB : enregistrer la notification
                            DB --> Notification : notification enregistrée
                            Notification --> NotificationService : confirmation
                            NotificationService --> Commande : rappel envoyé

                            Commande --> Utilisateur : recevoir notification de rappel
                        end
                    end
                end
            end
        end
    end
end

== Fin du traitement ==

Commande -> Scheduler : terminer l'exécution

@enduml