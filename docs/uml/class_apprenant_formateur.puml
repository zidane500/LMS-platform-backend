@startuml
title Diagramme de classes - Apprenant et Formateur

skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #334155
}

class Apprenant {
  .. Attributs ..
  + user_id
  + domaines_cibles
  + technologies
  .. Fonctions ..
  + user()
}

class Formateur {
  .. Attributs ..
  + user_id
  + specialite
  + experience_annees
  + langues_enseignees
  .. Fonctions ..
  + user()
}

Apprenant .. Formateur : interaction pédagogique

@enduml
