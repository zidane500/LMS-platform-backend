@startuml
title Diagramme de séquence - Connexion d'un utilisateur

skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F1F5F9
  ActorBorderColor #334155
  ActorBackgroundColor #E0F2FE
  DatabaseBorderColor #334155
  DatabaseBackgroundColor #ECFDF5
}

autonumber

actor "Utilisateur" as Utilisateur
boundary "Interface React\nLogin.tsx" as Interface
control "AuthContext" as AuthContext
control "authService.ts" as AuthService
control "AuthController" as AuthController
entity "Modèle User" as UserModel
database "Base de données\nPostgreSQL" as DB
control "Laravel Sanctum" as Sanctum
collections "LocalStorage" as LocalStorage
boundary "Dashboard" as Dashboard

loop Tant que l'utilisateur n'est pas connecté
    Utilisateur -> Interface : saisir email et mot de passe
    Utilisateur -> Interface : cliquer sur le bouton Connexion
    Interface -> Interface : contrôler les champs du formulaire

    alt Champs invalides ou vides
        Interface --> Utilisateur : afficher les erreurs de saisie
    else Champs valides
        Interface -> AuthContext : login(email, password)
        AuthContext -> AuthService : loginUser(data)
        AuthService -> AuthController : POST /api/login\n(email, password)
        AuthController -> AuthController : valider les données reçues
        AuthController -> UserModel : rechercher utilisateur par email
        UserModel -> DB : SELECT * FROM users WHERE email = ?
        DB --> UserModel : utilisateur trouvé ou null
        UserModel --> AuthController : résultat de la recherche
        AuthController -> AuthController : vérifier le mot de passe

        alt Email inexistant ou mot de passe incorrect
            AuthController --> AuthService : réponse 401\nIdentifiants incorrects
            AuthService --> AuthContext : erreur de connexion
            AuthContext --> Interface : retourner l'erreur
            Interface --> Utilisateur : afficher message d'erreur
        else Identifiants corrects
            AuthController -> Sanctum : créer un token d'accès
            Sanctum --> AuthController : token généré
            AuthController --> AuthService : réponse 200\nuser + token
            AuthService --> AuthContext : retourner user + token
            AuthContext -> LocalStorage : stocker auth_token
            AuthContext -> LocalStorage : stocker auth_user
            AuthContext -> AuthContext : setCurrentUser(user)
            AuthContext --> Interface : connexion réussie
            Interface -> Dashboard : rediriger vers /app/dashboard
            Dashboard --> Utilisateur : afficher l'espace utilisateur
        end
    end
end

@enduml
