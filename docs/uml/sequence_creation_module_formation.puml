@startuml
title Diagramme de séquence - Création d'un module d'une formation

skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F1F5F9
  ActorBorderColor #334155
  ActorBackgroundColor #E0F2FE
  DatabaseBorderColor #334155
  DatabaseBackgroundColor #ECFDF5
}

autonumber

actor "Administrateur / Formateur" as Acteur
boundary "Interface React\nEditCourse.tsx" as Interface
control "ModuleController" as ModuleController
entity "Modèle Formation" as Formation
entity "Modèle ModuleFormation" as Module
database "Base de données\nPostgreSQL" as DB

== Accès à la formation ==

Acteur -> Interface : ouvrir la page de modification d'une formation
Interface -> ModuleController : demander les informations de la formation
ModuleController -> DB : rechercher la formation
DB --> ModuleController : formation trouvée ou introuvable

alt Formation introuvable
    ModuleController --> Interface : retourner une erreur
    Interface --> Acteur : afficher formation introuvable
else Formation trouvée
    ModuleController --> Interface : retourner les informations de la formation
    Interface --> Acteur : afficher les modules existants
end

== Création du module ==

Acteur -> Interface : cliquer sur Ajouter un module
Interface --> Acteur : afficher le formulaire du module

Acteur -> Interface : saisir les informations du module
note right of Interface
Titre du module
Description
Durée
Ordre
end note

Acteur -> Interface : cliquer sur Enregistrer
Interface -> Interface : vérifier les champs obligatoires

alt Champs invalides
    Interface --> Acteur : afficher les erreurs de saisie
else Champs valides
    Interface -> ModuleController : envoyer les données du module\nPOST /formations/{formationId}/modules

    ModuleController -> Formation : vérifier la formation concernée
    Formation -> DB : rechercher la formation
    DB --> Formation : formation trouvée ou introuvable
    Formation --> ModuleController : résultat de la recherche

    alt Formation introuvable
        ModuleController --> Interface : retourner une erreur
        Interface --> Acteur : afficher formation introuvable
    else Formation trouvée
        ModuleController -> ModuleController : vérifier le droit de création

        alt Accès refusé
            ModuleController --> Interface : refuser l'opération
            Interface --> Acteur : afficher accès refusé
        else Accès autorisé
            ModuleController -> ModuleController : valider les données du module

            alt Données invalides
                ModuleController --> Interface : retourner les erreurs de validation
                Interface --> Acteur : afficher les erreurs
            else Données valides
                ModuleController -> Module : créer un nouveau module
                Module -> DB : enregistrer le module
                DB --> Module : module enregistré
                Module --> ModuleController : module créé

                ModuleController --> Interface : retourner le module créé
                Interface --> Acteur : afficher message de succès
                Interface --> Acteur : mettre à jour la liste des modules
            end
        end
    end
end

@enduml