@startuml
title Diagramme de cas d'utilisation - Sprint 1

left to right direction

skinparam backgroundColor #FFFFFF
skinparam linetype ortho
skinparam dpi 160

skinparam actor {
  BorderColor #334155
  BackgroundColor #E0F2FE
  FontColor #0F172A
}

skinparam usecase {
  BorderColor #7CA7D9
  BackgroundColor #DCEBFF
  FontColor #0F172A
}

skinparam rectangle {
  BorderColor #111827
  BackgroundColor #FFFFFF
  FontColor #0F172A
}

actor "Utilisateur" as Utilisateur
actor "Apprenant" as Apprenant
actor "Formateur" as Formateur
actor "Administrateur" as Admin

Apprenant --|> Utilisateur
Formateur --|> Utilisateur

rectangle "Sprint 1 : Authentification et gestion des utilisateurs" {

  usecase "Créer un compte" as UC_CREER_COMPTE
  usecase "Se connecter" as UC_CONNECTER
  usecase "Accéder à l'espace\npersonnel selon le rôle" as UC_ESPACE_ROLE

  usecase "Gérer son profil" as UC_GERER_PROFIL
  usecase "Modifier le profil" as UC_MODIFIER_PROFIL

  usecase "Demander le rôle\nFormateur" as UC_DEMANDER_FORMATEUR
  usecase "Remplir le formulaire\nde demande" as UC_REMPLIR_FORMULAIRE
  usecase "Soumettre la demande" as UC_SOUMETTRE_DEMANDE

  usecase "Gérer les utilisateurs" as UC_GERER_USERS
  usecase "Attribuer un rôle" as UC_ATTRIBUER_ROLE
  usecase "Modifier un compte\nutilisateur" as UC_MODIFIER_USER
  usecase "Supprimer un compte\nutilisateur" as UC_SUPPRIMER_USER

  usecase "Traiter les demandes\nformateur" as UC_TRAITER_DEMANDES
  usecase "Consulter les demandes" as UC_CONSULTER_DEMANDES
  usecase "Valider une demande" as UC_VALIDER_DEMANDE
  usecase "Refuser une demande" as UC_REFUSER_DEMANDE
}

' Relations principales
Utilisateur --> UC_CREER_COMPTE
Utilisateur --> UC_CONNECTER
Utilisateur --> UC_GERER_PROFIL

Apprenant --> UC_DEMANDER_FORMATEUR

Admin --> UC_GERER_USERS
Admin --> UC_TRAITER_DEMANDES

' Raffinements authentification
UC_CONNECTER .> UC_ESPACE_ROLE : <<include>>

' Raffinements profil
UC_MODIFIER_PROFIL .> UC_GERER_PROFIL : <<extend>>

' Raffinements demande formateur
UC_DEMANDER_FORMATEUR .> UC_REMPLIR_FORMULAIRE : <<include>>
UC_DEMANDER_FORMATEUR .> UC_SOUMETTRE_DEMANDE : <<include>>

' Raffinements gestion utilisateurs
UC_GERER_USERS .> UC_ATTRIBUER_ROLE : <<include>>
UC_GERER_USERS .> UC_MODIFIER_USER : <<include>>
UC_GERER_USERS .> UC_SUPPRIMER_USER : <<include>>

' Raffinements demandes formateur
UC_TRAITER_DEMANDES .> UC_CONSULTER_DEMANDES : <<include>>
UC_TRAITER_DEMANDES .> UC_VALIDER_DEMANDE : <<extend>>
UC_TRAITER_DEMANDES .> UC_REFUSER_DEMANDE : <<extend>>

' Organisation visuelle
UC_CREER_COMPTE -[hidden]down- UC_CONNECTER
UC_CONNECTER -[hidden]down- UC_GERER_PROFIL
UC_GERER_PROFIL -[hidden]down- UC_DEMANDER_FORMATEUR

UC_GERER_USERS -[hidden]down- UC_TRAITER_DEMANDES

@enduml