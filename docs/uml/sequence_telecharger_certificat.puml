@startuml
title Diagramme de séquence - Télécharger un certificat

skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 16
skinparam titleFontSize 22

skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC

  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F1F5F9
  ParticipantFontSize 17

  ActorBorderColor #334155
  ActorBackgroundColor #E0F2FE
  ActorFontSize 17

  DatabaseBorderColor #334155
  DatabaseBackgroundColor #ECFDF5
  DatabaseFontSize 17

  ArrowFontSize 16
  NoteFontSize 16
}

autonumber

actor "Apprenant" as Apprenant
boundary "Interface React\nCertificats" as Interface
control "CertificatController" as CertificatController
entity "Modèle Certificat" as Certificat
database "Base de données\nPostgreSQL" as DB
control "Générateur PDF" as PdfService

== Consultation des certificats ==

Apprenant -> Interface : ouvrir la page des certificats
Interface -> CertificatController : demander la liste des certificats
CertificatController -> DB : rechercher les certificats de l'apprenant
DB --> CertificatController : certificats disponibles
CertificatController --> Interface : retourner la liste des certificats
Interface --> Apprenant : afficher les certificats

== Téléchargement du certificat ==

Apprenant -> Interface : cliquer sur Télécharger
Interface -> CertificatController : demander le téléchargement du certificat

CertificatController -> Certificat : vérifier le certificat demandé
Certificat -> DB : rechercher le certificat
DB --> Certificat : certificat trouvé ou introuvable
Certificat --> CertificatController : résultat de la recherche

alt Certificat introuvable
    CertificatController --> Interface : retourner une erreur
    Interface --> Apprenant : afficher certificat introuvable
else Certificat trouvé
    CertificatController -> CertificatController : vérifier que le certificat appartient à l'apprenant

    alt Accès refusé
        CertificatController --> Interface : refuser le téléchargement
        Interface --> Apprenant : afficher accès refusé
    else Accès autorisé
        CertificatController -> DB : récupérer les informations du certificat
        DB --> CertificatController : apprenant, formation, moyenne et mention

        CertificatController -> PdfService : générer le fichier PDF du certificat
        PdfService --> CertificatController : fichier PDF généré

        CertificatController --> Interface : retourner le fichier PDF
        Interface --> Apprenant : télécharger le certificat
    end
end

@enduml