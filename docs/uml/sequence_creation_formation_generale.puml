@startuml
title Diagramme de séquence - Création d'une formation

skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F1F5F9
  ActorBorderColor #334155
  ActorBackgroundColor #E0F2FE
  DatabaseBorderColor #334155
  DatabaseBackgroundColor #ECFDF5
}

autonumber

actor "Administrateur / Formateur" as Acteur
boundary "Interface React\nCreateCourse.tsx" as Interface
control "FormationController" as FormationController
entity "Formation" as Formation
database "Base de données\nPostgreSQL" as DB

== Création d'une formation ==

Acteur -> Interface : accéder au formulaire de création
Interface --> Acteur : afficher le formulaire

Acteur -> Interface : saisir les informations de la formation
Acteur -> Interface : cliquer sur Enregistrer

Interface -> FormationController : envoyer les données de la formation

FormationController -> FormationController : vérifier les autorisations

alt Utilisateur non autorisé
    FormationController --> Interface : refuser l'accès
    Interface --> Acteur : afficher message d'erreur
else Utilisateur autorisé
    FormationController -> FormationController : valider les données

    alt Données invalides
        FormationController --> Interface : retourner les erreurs
        Interface --> Acteur : afficher les erreurs de validation
    else Données valides
        FormationController -> Formation : créer la formation
        Formation -> DB : enregistrer la formation
        DB --> Formation : confirmation
        Formation --> FormationController : formation créée

        FormationController --> Interface : retourner la formation créée
        Interface --> Acteur : afficher message de succès
    end
end

@enduml