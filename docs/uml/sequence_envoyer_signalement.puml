@startuml
title Diagramme de séquence - Envoyer un signalement

skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 16
skinparam titleFontSize 22

skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC

  ParticipantBorderColor #334155
  ParticipantBackgroundColor #F1F5F9
  ParticipantFontSize 17

  ActorBorderColor #334155
  ActorBackgroundColor #E0F2FE
  ActorFontSize 17

  DatabaseBorderColor #334155
  DatabaseBackgroundColor #ECFDF5
  DatabaseFontSize 17

  ArrowFontSize 16
  NoteFontSize 16
}

autonumber

actor "Utilisateur\n(Apprenant / Formateur)" as Utilisateur
boundary "Interface React\nReportWidget" as Interface
control "ReportController" as ReportController
database "Stockage fichiers" as Storage
control "Service Mail" as MailService
control "NotificationService" as NotificationService
database "Base de données\nNotifications" as DB
actor "Administrateur" as Admin

== Ouverture du formulaire ==

Utilisateur -> Interface : cliquer sur Signaler un problème
Interface --> Utilisateur : afficher le formulaire de signalement

Utilisateur -> Interface : saisir le résumé
Utilisateur -> Interface : saisir le message détaillé

opt Pièces jointes
    Utilisateur -> Interface : joindre des fichiers
    Interface -> Interface : vérifier le nombre de fichiers
end

Utilisateur -> Interface : cliquer sur Envoyer le signalement

== Validation côté interface ==

Interface -> Interface : vérifier les champs obligatoires

alt Résumé ou message vide
    Interface --> Utilisateur : afficher une erreur de saisie
else Données saisies
    Interface -> ReportController : envoyer le signalement\nPOST /api/reports

    == Traitement côté serveur ==

    ReportController -> ReportController : valider résumé, message et fichiers

    alt Données invalides
        ReportController --> Interface : retourner les erreurs de validation
        Interface --> Utilisateur : afficher les erreurs
    else Données valides

        opt Fichiers joints
            ReportController -> Storage : enregistrer les fichiers
            Storage --> ReportController : chemins des fichiers enregistrés
        end

        ReportController -> MailService : envoyer le signalement par e-mail
        MailService --> ReportController : e-mail envoyé à la plateforme

        ReportController -> NotificationService : créer une notification warning
        NotificationService -> DB : enregistrer la notification administrateur
        DB --> NotificationService : notification enregistrée
        NotificationService --> Admin : recevoir une alerte de signalement

        ReportController --> Interface : confirmer l'envoi du signalement
        Interface --> Utilisateur : afficher message de succès
    end
end

@enduml