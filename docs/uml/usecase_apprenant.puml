@startuml
title Diagramme de cas d'utilisation - Apprenant

left to right direction

skinparam backgroundColor #FFFFFF
skinparam actor {
  BorderColor #334155
  BackgroundColor #E0F2FE
  FontColor #0F172A
}

skinparam usecase {
  BorderColor #334155
  BackgroundColor #F8FAFC
  FontColor #0F172A
}

skinparam rectangle {
  BorderColor #64748B
  BackgroundColor #FFFFFF
}

actor "Apprenant" as Apprenant

rectangle "Plateforme LMS" {

  usecase "Créer un compte" as UC1
  usecase "Se connecter" as UC2
  usecase "Consulter le dashboard" as UC3
  usecase "Modifier son profil" as UC4

  usecase "Consulter les formations" as UC5
  usecase "Voir les détails\nd'une formation" as UC6
  usecase "S'inscrire à une formation" as UC7
  usecase "Payer une formation" as UC8
  usecase "Accéder à une\nformation codée" as UC9

  usecase "Consulter les modules" as UC10
  usecase "Consulter les contenus" as UC11
  usecase "Suivre sa progression" as UC12

  usecase "Passer un quiz" as UC13
  usecase "Consulter le résultat\ndu quiz" as UC14
  usecase "Recevoir un feedback IA" as UC15

  usecase "Obtenir des badges" as UC16
  usecase "Obtenir un certificat" as UC17
  usecase "Télécharger le certificat" as UC18
  usecase "Vérifier un certificat\npar QR code" as UC19

  usecase "Envoyer un message\nau formateur" as UC20
  usecase "Effectuer un appel\nvocal ou vidéo" as UC21
  usecase "Donner un feedback\nsur une formation" as UC22

  usecase "Recevoir des notifications" as UC23
  usecase "Recevoir un rappel\nformation non terminée" as UC24
  usecase "Envoyer un signalement" as UC25
}

