@startuml
title Description détaillée du CU d'apprenant

left to right direction

skinparam backgroundColor #FFFFFF

skinparam actor {
  BorderColor #6B7280
  BackgroundColor #E0F2FE
  FontColor #111827
}

skinparam usecase {
  BorderColor #8AB4E8
  BackgroundColor #DCEBFF
  FontColor #111827
}

skinparam rectangle {
  BorderColor #000000
  BackgroundColor #FFFFFF
  FontColor #111827
}

actor "Apprenant" as Apprenant

rectangle "Description détaillée du CU d'apprenant" {

  usecase "Gérer compte" as UC_GERER_COMPTE
  usecase "Se connecter" as UC_CONNECTER
  usecase "S'inscrire" as UC_INSCRIRE
  usecase "Réinitialiser le mot de passe" as UC_RESET
  usecase "Modifier le profil" as UC_PROFIL

  usecase "Demander rôle Formateur" as UC_DEMANDER_ROLE
  usecase "Remplir le formulaire de demande" as UC_FORMULAIRE

  usecase "Lister les formations" as UC_LISTER_FORMATIONS
  usecase "Consulter une formation" as UC_CONSULTER_FORMATION
  usecase "Rechercher une formation" as UC_RECHERCHER_FORMATION
  usecase "Recherche par titre" as UC_RECHERCHE_TITRE
  usecase "Recherche par catégorie" as UC_RECHERCHE_CATEGORIE
  usecase "Recherche par niveau" as UC_RECHERCHE_NIVEAU

  usecase "Consulter le dashboard d'apprenant" as UC_DASHBOARD
  usecase "Voir formations en cours / terminées" as UC_FORMATIONS_STATUT
  usecase "Voir progression" as UC_PROGRESSION
  usecase "Voir badges obtenus" as UC_BADGES

  usecase "Suivre une formation" as UC_SUIVRE_FORMATION
  usecase "Consulter les modules" as UC_MODULES
  usecase "Consulter les contenus" as UC_CONTENUS
  usecase "Marquer contenu comme terminé" as UC_CONTENU_TERMINE
  usecase "Accéder à une formation codée" as UC_FORMATION_CODEE
  usecase "Payer une formation" as UC_PAYER_FORMATION

  usecase "Passer une évaluation" as UC_EVALUATION
  usecase "Passer un quiz" as UC_QUIZ
  usecase "Répondre aux questions QCM" as UC_QCM
  usecase "Répondre aux questions Vrai/Faux" as UC_VF
  usecase "Répondre aux questions texte" as UC_TEXTE
  usecase "Recevoir correction IA" as UC_IA
  usecase "Voir score obtenu" as UC_SCORE

  usecase "Consulter récompenses" as UC_RECOMPENSES
  usecase "Obtenir badge" as UC_OBTENIR_BADGE
  usecase "Obtenir certificat" as UC_CERTIFICAT
  usecase "Télécharger certificat" as UC_TELECHARGER_CERTIFICAT
  usecase "Vérifier certificat par QR code" as UC_VERIFIER_CERTIFICAT

  usecase "Communiquer avec le formateur" as UC_COMMUNIQUER
  usecase "Envoyer message" as UC_MESSAGE
  usecase "Appel vocal" as UC_APPEL_VOCAL
  usecase "Appel vidéo" as UC_APPEL_VIDEO

  usecase "Consulter notifications" as UC_NOTIFICATIONS
  usecase "Recevoir rappel formation non terminée" as UC_RAPPEL
  usecase "Recevoir code formation codée" as UC_CODE_RECU
  usecase "Envoyer signalement" as UC_SIGNALEMENT
  usecase "Donner feedback" as UC_FEEDBACK
}

' Position verticale des cas globaux
UC_GERER_COMPTE -[hidden]down- UC_DEMANDER_ROLE
UC_DEMANDER_ROLE -[hidden]down- UC_LISTER_FORMATIONS
UC_LISTER_FORMATIONS -[hidden]down- UC_DASHBOARD
UC_DASHBOARD -[hidden]down- UC_SUIVRE_FORMATION
UC_SUIVRE_FORMATION -[hidden]down- UC_EVALUATION
UC_EVALUATION -[hidden]down- UC_RECOMPENSES
UC_RECOMPENSES -[hidden]down- UC_COMMUNIQUER
UC_COMMUNIQUER -[hidden]down- UC_NOTIFICATIONS

' Relations acteur avec les cas globaux
Apprenant --> UC_GERER_COMPTE
Apprenant --> UC_DEMANDER_ROLE
Apprenant --> UC_LISTER_FORMATIONS
Apprenant --> UC_DASHBOARD
Apprenant --> UC_SUIVRE_FORMATION
Apprenant --> UC_EVALUATION
Apprenant --> UC_RECOMPENSES
Apprenant --> UC_COMMUNIQUER
Apprenant --> UC_NOTIFICATIONS

' Raffinements de gérer compte
UC_CONNECTER .left.> UC_GERER_COMPTE : <<extend>>
UC_INSCRIRE .left.> UC_GERER_COMPTE : <<extend>>
UC_RESET .left.> UC_GERER_COMPTE : <<extend>>
UC_PROFIL .left.> UC_GERER_COMPTE : <<extend>>

UC_CONNECTER -[hidden]down- UC_INSCRIRE
UC_INSCRIRE -[hidden]down- UC_RESET
UC_RESET -[hidden]down- UC_PROFIL

' Raffinement demander rôle formateur
UC_FORMULAIRE .left.> UC_DEMANDER_ROLE : <<extend>>

' Raffinements lister formations
UC_CONSULTER_FORMATION .left.> UC_LISTER_FORMATIONS : <<extend>>
UC_RECHERCHER_FORMATION .left.> UC_LISTER_FORMATIONS : <<extend>>

UC_CONSULTER_FORMATION -[hidden]down- UC_RECHERCHER_FORMATION

UC_RECHERCHE_TITRE .left.> UC_RECHERCHER_FORMATION : <<extend>>
UC_RECHERCHE_CATEGORIE .left.> UC_RECHERCHER_FORMATION : <<extend>>
UC_RECHERCHE_NIVEAU .left.> UC_RECHERCHER_FORMATION : <<extend>>

UC_RECHERCHE_TITRE -[hidden]down- UC_RECHERCHE_CATEGORIE
UC_RECHERCHE_CATEGORIE -[hidden]down- UC_RECHERCHE_NIVEAU

' Raffinements dashboard apprenant
UC_FORMATIONS_STATUT .left.> UC_DASHBOARD : <<extend>>
UC_PROGRESSION .left.> UC_DASHBOARD : <<extend>>
UC_BADGES .left.> UC_DASHBOARD : <<extend>>

UC_FORMATIONS_STATUT -[hidden]down- UC_PROGRESSION
UC_PROGRESSION -[hidden]down- UC_BADGES

' Raffinements suivre formation
UC_MODULES .left.> UC_SUIVRE_FORMATION : <<extend>>
UC_CONTENUS .left.> UC_SUIVRE_FORMATION : <<extend>>
UC_CONTENU_TERMINE .left.> UC_CONTENUS : <<extend>>
UC_FORMATION_CODEE .left.> UC_SUIVRE_FORMATION : <<extend>>
UC_PAYER_FORMATION .left.> UC_SUIVRE_FORMATION : <<extend>>

UC_MODULES -[hidden]down- UC_CONTENUS
UC_CONTENUS -[hidden]down- UC_FORMATION_CODEE
UC_FORMATION_CODEE -[hidden]down- UC_PAYER_FORMATION

' Raffinements évaluation
UC_QUIZ .left.> UC_EVALUATION : <<extend>>
UC_QCM .left.> UC_QUIZ : <<extend>>
UC_VF .left.> UC_QUIZ : <<extend>>
UC_TEXTE .left.> UC_QUIZ : <<extend>>
UC_IA .left.> UC_TEXTE : <<extend>>
UC_SCORE .left.> UC_EVALUATION : <<extend>>

UC_QCM -[hidden]down- UC_VF
UC_VF -[hidden]down- UC_TEXTE
UC_TEXTE -[hidden]down- UC_SCORE

' Raffinements récompenses
UC_OBTENIR_BADGE .left.> UC_RECOMPENSES : <<extend>>
UC_CERTIFICAT .left.> UC_RECOMPENSES : <<extend>>
UC_TELECHARGER_CERTIFICAT .left.> UC_CERTIFICAT : <<extend>>
UC_VERIFIER_CERTIFICAT .left.> UC_CERTIFICAT : <<extend>>

UC_OBTENIR_BADGE -[hidden]down- UC_CERTIFICAT
UC_CERTIFICAT -[hidden]down- UC_TELECHARGER_CERTIFICAT
UC_TELECHARGER_CERTIFICAT -[hidden]down- UC_VERIFIER_CERTIFICAT

' Raffinements communication
UC_MESSAGE .left.> UC_COMMUNIQUER : <<extend>>
UC_APPEL_VOCAL .left.> UC_COMMUNIQUER : <<extend>>
UC_APPEL_VIDEO .left.> UC_COMMUNIQUER : <<extend>>

UC_MESSAGE -[hidden]down- UC_APPEL_VOCAL
UC_APPEL_VOCAL -[hidden]down- UC_APPEL_VIDEO

' Raffinements notifications
UC_RAPPEL .left.> UC_NOTIFICATIONS : <<extend>>
UC_CODE_RECU .left.> UC_NOTIFICATIONS : <<extend>>
UC_SIGNALEMENT .left.> UC_NOTIFICATIONS : <<extend>>
UC_FEEDBACK .left.> UC_NOTIFICATIONS : <<extend>>

UC_RAPPEL -[hidden]down- UC_CODE_RECU
UC_CODE_RECU -[hidden]down- UC_SIGNALEMENT
UC_SIGNALEMENT -[hidden]down- UC_FEEDBACK

@enduml